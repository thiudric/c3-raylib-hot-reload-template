{
  "langrev": "1",
  "warnings": ["no-unused"],
  "dependency-search-paths": ["lib"],
  "authors": ["Theodric"],
  "version": "0.1.0",
  "build-dir": "build",
  "output": "build",
  "targets": {
    "game-linux": {
      "name": "game",
      "target": "linux-x64",
      "type": "dynamic-lib",
      "sources": ["src/game/**"],
      "dependencies": ["raylib6"],
      "linker-search-paths": ["build/raylib/raylib", "build/raygui"],
      "link-args": [
        "-l:libraylib.so.600",
        "-l:libraygui.so",
        "--rpath=$ORIGIN/../raygui:$ORIGIN/../raylib/raylib"
      ],
      "reloc": "PIC"
    },
    "game-windows": {
      "name": "game",
      "target": "windows-x64",
      "type": "dynamic-lib",
      "sources": ["src/game/**"],
      "dependencies": ["raylib6"],
      "linker-search-paths": ["build/raylib/raylib", "build/raygui"],
      "wincrt": "dynamic"
    },
    "host": {
      "type": "executable",
      "sources": ["src/host/**"]
    },
    "release-linux": {
      "name": "release",
      "target": "linux-x64",
      "type": "executable",
      "sources": ["src/release/**", "src/game/**"],
      "dependencies": ["raylib6"],
      "linker-search-paths": [
        "build/raylib-static/raylib",
        "build/raygui-static"
      ],
      "link-args": ["-l:libraygui.a", "-l:libraylib.a"],
      "opt": "O3",
      "debug-info": "none"
    },
    "release-windows": {
      "name": "release",
      "target": "windows-x64",
      "type": "executable",
      "sources": ["src/release/**", "src/game/**"],
      "dependencies": ["raylib6"],
      "linker-search-paths": [
        "build/raylib-static/raylib",
        "build/raygui-static"
      ],
      "wincrt": "dynamic",
      "opt": "O3",
      "debug-info": "none"
    }
  }
}
